    <!-- add sr no in account form -->
    <record id="view_move_form_line_no" model="ir.ui.view">
        <field name="name">account.move.form.line.no</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="before">
                <field name="line_no" string="#" readonly="1" width="40"/>
            </xpath>
        </field>
