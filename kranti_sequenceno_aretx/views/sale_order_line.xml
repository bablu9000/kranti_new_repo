<odoo>
    <record id="view_order_form_line_no" model="ir.ui.view">
        <field name="name">sale.order.form.line.no</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']"
                position="before">

                <field name="line_no"
                    string="Sr. No."
                    readonly="1"
                    width="40"/>

            </xpath>

        </field>
    </record>

</odoo>