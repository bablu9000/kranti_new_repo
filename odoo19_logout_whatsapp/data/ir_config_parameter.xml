    <record id="ir_cron_auto_logout_users" model="ir.cron">
        <field name="name">Auto Logout Users</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_logout_users()</field>
