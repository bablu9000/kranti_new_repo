<odoo>
    <record id="view_package_selection_wizard_form"
            model="ir.ui.view">

        <field name="name">package.selection.wizard.form</field>
        <field name="model">package.selection.wizard</field>

        <field name="arch" type="xml">
            <form string="Packages" class="package_selection_wizard">

                <group>
                    <field name="sale_line_id" readonly="1"/>
                </group>

                <field name="line_ids">
                    <list editable="bottom">
                        <field name="package_id"/>
                        <field name="quantity"/>
                        <field name="unit_qty" readonly="1"/>
                    </list>
                </field>

                <footer>
                    <button
                        name="action_save"
                        string="Save"
                        type="object"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"/>
                </footer>

            </form>
        </field>
    </record>
</odoo>