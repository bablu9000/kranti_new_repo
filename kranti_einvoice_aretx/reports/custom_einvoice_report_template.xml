<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_custom_einvoice">
        <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">

            <t t-set="edi_json" t-value="o._get_l10n_in_edi_response_json() or {}"/>
            <t t-set="ewaybill" t-value="env['l10n.in.ewaybill'].search([('account_move_id','=',o.id)], limit=1)"/>


            <t t-set="company" t-value="o.company_id"/>
            <t t-call="kranti_einvoice_aretx.custom_einvoice_layout">
                <div class="page einvoice-page" style="font-family: DejaVu Sans, sans-serif; !important; padding:0; margin-top:15mm; font-size: 12px; color: black;">
                    <div class="invoice-body">
                    <div class="oe_structure"/>
                        <style>
                            .table-goods {
                                <!-- table-layout: fixed !important; -->
                                width: 100% !important;
                                border-collapse: collapse !important;
                                margin-top: 10px !important;
                                
                            }

                            /* Apply a balanced 6px vertical padding and 8px horizontal padding */
                            .table-goods th, 
                            .table-goods td {
                                padding: 2px 8px !important; 
                                vertical-align: middle !important;
                                line-height: 1.3 !important;
                                <!-- font-size: 13px !important; -->
                                
                            }

                            /* Center-align structural metadata columns */
                            .text-center-goods {
                                text-align: center !important;
                            }

                            /* Right-align numeric columns for immaculate alignment */
                            .text-right-goods {
                                text-align: right !important;
                            }

                            .table-bank th, 
                            .table-bank td {
                                padding: 2px 8px !important; 
                                vertical-align: middle !important;
                                line-height: 1.3 !important;
                                <!-- font-size: 13px !important; -->
                                
                            }

                            .table-dispatch th, 
                            .table-dispatch td {
                                padding: 2px 8px !important; 
                                vertical-align: middle !important;
                                line-height: 1.3 !important;
                                <!-- font-size: 13px !important; -->
                                
                            }

                            .table-hsn th, 
                            .table-hsn td {
                                padding: 2px 8px !important; 
                                vertical-align: middle !important;
                                line-height: 1.3 !important;
                                <!-- font-size: 13px !important; -->
                                
                            }

                            .footer-table th, 
                            .footer-table td {
                                padding: 2px 8px !important; 
                                vertical-align: middle !important;
                                line-height: 1.3 !important;
                                <!-- font-size: 13px !important; -->
                                
                            }
                            .company-details-table{
                                width:100%;
                                font-size:14px;
                            }

                            .company-details-table table{
                                width:100%;
                                table-layout:fixed;
                                border-collapse:collapse;
                                border:none !important;
                            }

                            .table-irn td {
                                padding: 2px 8px !important; 
                                vertical-align: middle !important;
                                line-height: 1.3 !important;
                                border:none !important;
                            }

                            /* ========================================================= */
                            /* SIGNATURE                                                   */
                            /* ========================================================= */

                            .einvoice-signature {
                                width: 100% !important;
                                flex-shrink: 0 !important;
                            }

                            .signature-cell {
                                vertical-align: top !important;
                                height: 90px !important;
                            }

                            

                        </style>
    <!-- ................................................................................................... -->

