                            <td style="border: none !important"><strong> Due Date</strong></td>
                            <td style="border: none !important">: <span t-esc="o.invoice_date_due.strftime('%d-%m-%y') if o.invoice_date_due else ''"/></td>
                        </tr>

                        <tr style="border: none !important">
                            <td style="border: none !important"><strong> Supply From</strong></td>
