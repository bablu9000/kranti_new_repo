                    <!-- ========================================================= -->
                    <!-- ===================== PRODUCTS TABLE ==================== -->
                    <!-- ========================================================= -->

                    <t t-set="invoice_lines" t-value="o.invoice_line_ids"/>

                    <table class="table-goods"
                        style="
                            width: 100%;
                            border-collapse: collapse;
                            margin-top: 10px;
                        ">

                        <tr>
                            <td><strong>Sr No.</strong></td>
                            <td><strong>Part No.</strong></td>
                            <td><strong>Description of Goods</strong></td>
                            <td><strong>GST Rate</strong></td>
                            <td><strong>Qty</strong></td>
                            <td><strong>Unit</strong></td>
                            <td><strong>Rate</strong></td>
                            <td><strong>Basic Value</strong></td>
                        </tr>

                        <t t-foreach="invoice_lines" t-as="line">

                            <!-- Section -->
                            <tr t-if="line.display_type == 'line_section'">
                                <td colspan="8">
                                    <strong>
                                        <span t-field="line.name"/>
                                    </strong>
                                </td>
                            </tr>

                            <!-- Note -->
                            <tr t-elif="line.display_type == 'line_note'">
                                <td colspan="8">
                                    <em>
                                        <span t-field="line.name"/>
                                    </em>
                                </td>
                            </tr>

                            <!-- Product -->
                            <tr t-else="">

                                <!-- Sr No. -->
                                <td>
                                    <span t-esc="line_index + 1"/>
                                </td>

                                <!-- Part No. -->
                                <td>
                                    <span t-esc="line.product_id.default_code or ''"/>
                                </td>

                                <!-- ========================================================= -->
                                <!-- PRODUCT DESCRIPTION                                      -->
                                <!-- ========================================================= -->

                                <td>

                                    <!-- Base product name -->
                                    <t t-set="product_name" t-value="line.product_id.name or ''"/>

                                    <!-- Full invoice line description -->
                                    <t t-set="line_description" t-value="line.name or ''"/>

                                    <!-- Remove internal reference such as [REF001] -->
                                    <t t-if="'] ' in line_description">
                                        <t t-set="line_description"
                                        t-value="line_description.split('] ', 1)[1]"/>
                                    </t>

                                    <!-- Remove product name from the beginning -->
                                    <t t-if="product_name and line_description.startswith(product_name)">
                                        <t t-set="line_description"
                                        t-value="line_description[len(product_name):].strip()"/>
                                    </t>

                                    <!-- ===================================================== -->
                                    <!-- PRODUCT NAME + VARIANT                                -->
                                    <!-- ===================================================== -->

                                    <t t-set="variant_text" t-value="''"/>

                                    <!--
                                        Odoo can place the product variant on the first
                                        remaining line, for example:

                                        (Black, XL)
                                        (1x1 ft, Matte)

                                        Keep that with the product name instead of
                                        forcing it onto a separate line.
                                    -->
                                    <t t-if="line_description.startswith('(') and ')' in line_description">

                                        <t t-set="variant_end"
                                        t-value="line_description.find(')') + 1"/>

                                        <t t-set="variant_text"
                                        t-value="line_description[:variant_end]"/>

                                        <t t-set="line_description"
                                        t-value="line_description[variant_end:].strip()"/>

                                    </t>

                                    <!-- Product name -->
                                    <span t-esc="product_name"/>

                                    <!-- Variant -->
                                    <t t-if="variant_text">
                                        <span t-esc="' ' + variant_text"/>
                                    </t>

                                    <!-- ===================================================== -->
                                    <!-- REMAINING DESCRIPTION / PACKAGING                    -->
                                    <!-- ===================================================== -->

                                    <t t-if="line_description">
                                        <br/>
                                        <span t-esc="line_description"/>
                                    </t>

                                </td>
                                <!-- GST -->
                                <td>
                                    <t t-foreach="line.tax_ids" t-as="tax">
                                        <span t-esc="tax.amount"/>%
                                    </t>
                                </td>

                                <!-- Qty -->
                                <td>
                                    <span t-esc="int(line.quantity)"/>
                                </td>

                                <!-- Unit -->
                                <td>
                                    <span t-esc="line.product_uom_id.name"/>
                                </td>

                                <!-- Rate -->
                                <td>
                                    <span t-esc="
                                        '%.2f' % (
                                            line.price_unit *
                                            (
                                                1 -
                                                (line.discount or 0.0) / 100.0
                                            )
                                        )
                                    "/>
                                </td>

                                <!-- Basic Value -->
                                <td>
                                    <span t-esc="'%.2f' % line.price_subtotal"/>
                                </td>

                            </tr>

                        </t>

                        <!-- Product Totals -->

                        <t t-set="total_qty"
                        t-value="sum(o.invoice_line_ids.mapped('quantity'))"/>

                        <t t-set="basic_total"
                        t-value="sum(o.invoice_line_ids.mapped('price_subtotal'))"/>

                        <tr>
                            <td colspan="8"
                                style="
                                    padding-top:15px;
                                    border:none;
                                    height:30px;
                                ">
                            </td>
                        </tr>

                        <tr>
                            <td></td>
                            <td></td>

                            <td>
                                <strong>Quantity Total</strong>
                            </td>

                            <td></td>

                            <td>
                                <strong t-esc="total_qty"/>
                            </td>

                            <td></td>

                            <td>
                                <strong>Total</strong>
                            </td>

                            <td>
                                <strong>
                                    <span t-esc="int(basic_total * 100) / 100"/>
                                </strong>
                            </td>
                        </tr>

                    </table>
                    
                    		    <!-- ========================================================= -->
                    <!-- ======================= HSN TABLE ======================= -->
                    <!-- ========================================================= -->

                    <t t-set="hsn_summary"
                    	t-value="o._l10n_in_get_hsn_summary_table()"/>
		    
		    <t t-set="tax_totals"
                    	t-value="o.tax_totals or {}"/>

                    <table class="table-hsn"
                        cellpadding="4"
                        cellspacing="0"
                        width="100%"
                        style="float: left !important;">

                        <tr>
                            <td rowspan="2"
                                align="center"
                                valign="middle">
                                HSN/SAC
                            </td>

                            <td rowspan="2"
                                align="center"
                                valign="middle">
                                Taxable Value
                            </td>

                            <td colspan="2"
                                align="center"
                                valign="middle">
                                CGST
                            </td>

                            <td colspan="2"
                                align="center"
                                valign="middle">
                                SGST/UTGST
                            </td>

                            <td rowspan="2"
                                align="center"
                                valign="middle">
                                Total<br/>
                                Tax Amt
                            </td>
                            <td align="left">
                                    Output SGST
                                </td>

                                <td align="right">
                                    <span t-esc="'%.2f' % sum(
                                        h['tax_amount_sgst']
                                        for h in hsn_summary['items']
                                    )"/>
                                </td>
                        </tr>

                        <tr>
                            <td align="center">Rate</td>
                            <td align="center">Amt</td>
                            <td align="center">Rate</td>
                            <td align="center">Amt</td>
                            <td align="left">
                                 Output CGST
                            </td>

                            <td align="right">
                                <span t-esc="'%.2f' % sum(
                                    h['tax_amount_cgst']
                                    for h in hsn_summary['items']
                                )"/>
                            </td>
                        </tr>

                        <!-- ================= HSN ROWS ================= -->

                        <t t-foreach="hsn_summary['items']" t-as="hsn" t-index="hsn_index">

                            <tr>

                                <!-- HSN/SAC -->
                                <td align="center">
                                    <span t-esc="hsn['l10n_in_hsn_code']"/>
                                </td>

                                <!-- Taxable Value -->
                                <td align="right">
                                    <span t-esc="'%.2f' % hsn['amount_untaxed']"/>
                                </td>

                                <!-- CGST Rate -->
                                <td align="center">
                                    <span t-esc="'%.1f' % hsn['rate']"/>%
                                </td>

                                <!-- CGST Amount -->
                                <td align="right">
                                    <span t-esc="'%.2f' % hsn['tax_amount_cgst']"/>
                                </td>

                                <!-- SGST Rate -->
                                <td align="center">
                                    <span t-esc="'%.1f' % hsn['rate']"/>%
                                </td>

                                <!-- SGST Amount -->
                                <td align="right">
                                    <span t-esc="'%.2f' % hsn['tax_amount_sgst']"/>
                                </td>

                                <!-- Total Tax -->
                                <td align="right">
                                    <span t-esc="'%.2f' % (
                                        hsn['tax_amount_cgst']
                                        + hsn['tax_amount_sgst']
                                        + hsn['tax_amount_igst']
                                        + hsn['tax_amount_cess']
                                    )"/>
                                </td>
                                <td align="left">

                            <t t-if="hsn_index == len(hsn_summary['items']) - 1">
                                Rounding Off
                            </t>

                        </td>

                        <td align="right">

                            <t t-if="hsn_index == len(hsn_summary['items']) - 1">

                                <t t-if="'cash_rounding_base_amount_currency' in tax_totals">

                                    <span t-esc="'%.2f' % (
                                        tax_totals['cash_rounding_base_amount_currency']
                                    )"/>

                                </t>

                                <t t-else="">
