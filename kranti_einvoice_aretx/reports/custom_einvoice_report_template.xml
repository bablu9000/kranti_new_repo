                        </tr>

                        <tr style="border: none !important">
                            <td style="border: none !important"><strong> Dispatch Through</strong></td>
                            <td colspan="3" style="border: none !important">: <span t-esc="o.transporter_id.name or ''"/></td>
    
                        </tr>

                        <tr style="border: none !important">
                            <td style="border: none !important"><strong> LR No.</strong></td>
                            <td style="border: none !important">: <span t-esc="o.lr_no or ''"/></td>
                            <td style="border: none !important"><strong> Date</strong></td>
                            <td style="border: none !important">: <span t-esc="o.lr_date or ''"/></td>
                        </tr>

                        <tr style="border: none !important">
                            <td style="border: none !important"><strong> Vehicle No.</strong></td>
                            <td colspan="3" style="border: none !important">: <span t-esc="o.vehicle_num or ''"/></td>
                        </tr>

                        <tr style="border: none !important">
