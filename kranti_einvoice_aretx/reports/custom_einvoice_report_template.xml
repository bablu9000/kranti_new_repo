                                            <strong>GSTIN/UIN</strong> &amp;nbsp;&amp;nbsp; <span t-esc="buy.vat or ''"/><br/>
                                            <strong>PAN No.</strong> <span t-esc="ship.l10n_in_pan_entity_id.name if ship.l10n_in_pan_entity_id else ''"/><br/>
                                            <strong>MSME No.</strong>
                                            
