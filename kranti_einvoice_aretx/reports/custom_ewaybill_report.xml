<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Paper Format -->

    <record id="paperformat_custom_ewaybill"
            model="report.paperformat">

        <field name="name">Custom Invoice Paper Format</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>

        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>

        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>

        <field name="dpi">90</field>

    </record>

    <!-- Report Action -->

    <record id="action_report_custom_invoice" model="ir.actions.report">
        <field name="name">E-Way Bill PDF</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">kranti_einvoice_aretx.report_custom_ewaybill_document</field>
        <field name="report_file">kranti_einvoice_aretx.report_custom_ewaybill_document</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="kranti_einvoice_aretx.paperformat_custom_ewaybill"/>
        <field name="print_report_name">'E-Way Bill - %s' % (object.partner_id.name)</field>
        <field name="attachment">(object.name or '').replace('/','_') + '_ewaybill.pdf'</field>

    </record>

</odoo>