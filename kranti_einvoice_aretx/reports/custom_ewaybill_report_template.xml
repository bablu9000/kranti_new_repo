<?xml version="1.0" encoding="utf-8"?>

<odoo>
     <template id="report_custom_ewaybill_document">

        <t t-call="web.html_container">   
        <t t-foreach="docs" t-as="o">

            <t t-set="ewaybill" t-value="env['l10n.in.ewaybill'].search([('account_move_id', '=', o.id)], limit=1)"/>
            <t t-set="edi_json" t-value="o._get_l10n_in_edi_response_json() or {}"/>


            <t t-call="web.basic_layout">
            <div class="custom-ewaybill-report">
                    <div class="page">

                        <!-- ================= HEADER ================= -->

                        <div class="header-center">
                            <div class="report-title">
                                <strong>e-Way Bill</strong>
                            </div>
                        </div>

                        <div class="row">

                            <div class="col-8">

                                <div>
                                    <strong>Doc No.</strong>
                                    <span class="space-doc" t-esc="ewaybill.document_number"/>
                                </div>

                                <div>
                                    <strong>Date</strong>
                                    <span class="space-date" t-esc="o.invoice_date.strftime('%d-%b-%y') if o.invoice_date else ''"/>
                                </div>

                                <br/>

                                <div t-if="edi_json">
                                    <strong>IRN</strong>
                                    <span class="space-irn"
                                        t-esc="edi_json.get('Irn', '')"/>
                                </div>

                                <div t-if="edi_json">
                                    <strong>Ack No.</strong>
                                    <span class="space-ack"
                                        t-esc="edi_json.get('AckNo', '')"/>
                                </div>

                                <div t-if="edi_json">
                                    <strong>Ack Date</strong>
                                    <span class="space-ackdate"
                                        t-esc="edi_json.get('AckDt', '')"/>
                                </div>

                            </div>

                            <div class="col-4 text-center">
                                <t t-if="ewaybill">
                                    <t t-set="ewaybill_qr" t-value="ewaybill._get_ewaybill_qr_data()"/>

                                    <t t-if="ewaybill_qr">
                                        <div class="qr-title">
                                            e-Way Bill
                                        </div>

                                        <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s'
                                            % ('QR', ewaybill_qr, 500, 500, 0)"
                                            style="width:120px;height:120px;"/>
                                    </t>
                                </t>
                            </div>

                        </div>

                        <hr class="report-line"/>

                        <!-- ================= EWAY BILL ================= -->

                        <h5 class="section-heading">
                            1. e-Way Bill Details
                        </h5>

                        <table class="eway-table">

                            <tr>

                                <td>e-Way Bill No</td>
                                <td class="colon">:</td>
                                <td>
                                    <span t-esc="ewaybill.name"/>
                                </td>

                                <td>Mode</td>
                                <td class="colon">:</td>
                                <td><t t-esc="dict(ewaybill._fields['mode']._description_selection(ewaybill.env)).get(ewaybill.mode, '')"/></td>

                                <td>Generated Date</td>
                                <td class="colon">:</td>
                                <td>
                                    <span t-esc="ewaybill.ewaybill_date"/>
                                </td>

                            </tr>

                            <tr>

                                <td>Generated By</td>
                                <td class="colon">:</td>
                                <td>
                                    <span t-esc="o.company_id.vat"/>
                                </td>

                                <td>Approx Distance</td>
                                <td class="colon">:</td>
                                <td>
                                    <span t-esc="ewaybill.distance"/> KM
                                </td>

                                <td>Valid Upto</td>
                                <td class="colon">:</td>
                                <td>
                                    <span t-esc="ewaybill.ewaybill_expiry_date"/>
                                </td>

                                
                            </tr>

                            <tr>

                                <td>Supply Type</td>
                                <td class="colon">:</td>
                                <td>Outward Supply</td>

                                <td>Transaction Type</td>
                                <td class="colon">:</td>
                                <td>Regular</td>
                                
                                <td>Transporter</td>
                                <td class="colon">:</td>
                                <td>
                                    <span t-esc="ewaybill.transporter_id.name"/>
                                </td>

                            </tr>

                        </table>

                        <hr class="report-line"/>

                        <h5 class="section-heading">
                            2. Address Details
                        </h5>

                        <table class="address-table">

                            <tr>

                                <td class="address-cell">

                                    <strong>From</strong>

                                    <br/><br/>

                                        <span t-esc="ewaybill.partner_bill_from_id.name"/>
                                    <br/>
                                        GSTIN : <span t-esc="ewaybill.partner_bill_from_id.vat"/>
                                    <br/>
                                    <span t-esc="ewaybill.partner_bill_from_id.state_id.name"/>

                                </td>

                                <td class="address-cell">

                                    <strong>To</strong>

                                    <br/><br/>

                                    <span t-esc="ewaybill.partner_bill_to_id.name"/>
                                    <br/>
                                    GSTIN : <span t-esc="ewaybill.partner_bill_to_id.vat"/>
                                    <br/>
                                    <span t-esc="ewaybill.partner_bill_to_id.state_id.name"/>

                                </td>

                            </tr>

                            <tr>

                                <td class="address-cell address-top">

                                    <strong>Dispatch From</strong>

                                    <br/><br/>

                                    <span t-field="ewaybill.partner_ship_from_id"
                                        t-options="{'widget':'contact','fields':['address'],'no_marker':True}"/>

                                </td>

                                <td class="address-cell address-top">

                                    <strong>Ship To</strong>

                                    <br/><br/>

                                    <span t-field="ewaybill.partner_ship_to_id"
                                        t-options="{'widget':'contact','fields':['address'],'no_marker':True}"/>

                                </td>

                            </tr>

                        </table>

                        <hr class="report-line"/>

                        <!-- ================= GOODS ================= -->
                        <t t-set="generate_json" t-value="ewaybill._ewaybill_generate_direct_json()"/>
                        <h5 class="section-heading">
                            3. Goods Details
                        </h5>

                        <table class="goods-table">

                            <thead>

                                <tr>

                                    <th>HSN Code</th>
                                    <th>Product Name &amp; Desc</th>
                                    <th>Qty</th>
                                    <th>Taxable Amt</th>
                                    <th>Tax Rate
                                        (C + S)</th>

                                </tr>

                            </thead>

                            <tbody>

                            <t t-foreach="generate_json['itemList']" t-as="item">

                                <tr>

                                    <td>
                                        <t t-out="item.get('hsnCode', '')"/>
                                    </td>

                                    <td>
                                        <t t-out="item.get('productDesc', '')"/>
                                    </td>

                                    <td>
                                        <t t-out="item.get('quantity', '')"/>
                                    </td>

                                    <td>
                                        <t t-out="item.get('taxableAmount', '')"/>
                                    </td>

                                    <td>

                                        <t t-if="item.get('cgstRate') and item.get('sgstRate')">

                                            <t t-out="int(item.get('cgstRate', 0))"/>
                                            +
                                            <t t-out="int(item.get('sgstRate', 0))"/>

                                        </t>

                                        <t t-elif="item.get('igstRate')">

                                            <t t-out="int(item.get('igstRate', 0))"/>

                                        </t>

                                        <t t-else="">
                                            0
                                        </t>

                                    </td>

                                </tr>

                            </t>

                        </tbody>

                        </table>

                        <hr class="report-line"/>

                        <!-- ================= TOTAL ================= -->
                        <div class="totals-section">

                            <table class="totals-table">
                                <tr>
                                    <td>Tot.Taxable Amt</td>
                                    <td class="colon">:</td>
                                    <td class="amount">
                                        <t t-out="generate_json.get('totalValue', 0)"/>
                                    </td>

                                    <td>Other Amt</td>
                                    <td class="colon">:</td>
                                    <td class="amount">
                                        <t t-out="generate_json.get('otherValue', 0)"/>
                                    </td>

                                    <td>Total Inv Amt</td>
                                    <td class="colon">:</td>
                                    <td class="amount">
                                        <strong>
                                            <t t-out="generate_json.get('totInvValue', 0)"/>
                                        </strong>
                                    </td>
                                </tr>

                                <tr>
                                    <td>CGST Amt</td>
                                    <td class="colon">:</td>
                                    <td class="amount">
                                        <t t-out="generate_json.get('cgstValue', 0)"/>
                                    </td>

                                    <td>SGST Amt</td>
                                    <td class="colon">:</td>
                                    <td class="amount">
                                        <t t-out="generate_json.get('sgstValue', 0)"/>
                                    </td>
                                </tr>

                            </table>

                        </div>

                        <hr class="report-line"/>
                        <!-- ================= TRANSPORT ================= -->

                        <h5 class="section-heading">
                            4. Transportation Details
                        </h5>

                        <div class="row">

                            <div class="col-6">
                                Transporter ID : <span t-esc="ewaybill.transporter_id.vat"/>
                            </div>

                            <div class="col-6">
                                Doc No. : <span t-esc="ewaybill.transportation_doc_no"/>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col-6">
                                Name : <span t-esc="ewaybill.transporter_id.name"/>
                            </div>

                            <div class="col-6">
                                Date : <span t-esc="ewaybill.transportation_doc_date"/>
                            </div>

                        </div>

                        <hr class="report-line"/>

                        <!-- ================= VEHICLE ================= -->

                        <h5 class="section-heading">
                            5. Vehicle Details
                        </h5>

                        <div class="row">

                            <div class="col-4">
                                 Vehicle No. : <span t-esc="ewaybill.vehicle_no"/>
                            </div>

                            <div class="col-4">
                                From :<span t-esc="generate_json['fromPlace']"/>
                            </div>

                            <div class="col-4">
                                CEWB No. :
                            </div>

                        </div>

                    </div>
                </div>
            </t>

        </t>
        </t>

    </template>

</odoo>