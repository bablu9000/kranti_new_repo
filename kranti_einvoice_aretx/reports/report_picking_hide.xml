<odoo>
    <template id="report_picking_hide_details" inherit_id="stock.report_picking">

        <xpath expr="//div[@name='right_box']" position="replace"/>
        <xpath expr="//div[@name='div_outgoing_address']" position="replace"/>
    </template>

    <template id="report_delivery_hide_address"
            inherit_id="stock.report_delivery_document">

        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address"/>
        </xpath>

    </template>

</odoo>