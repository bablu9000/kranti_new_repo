<odoo>

    <template id="report_saleorder_document_gst"
              inherit_id="sale.report_saleorder_document">

        <!-- ================= HEADER ================= -->

        <!-- Remove old Taxes header -->
        <xpath expr="//th[@name='th_taxes']" position="replace"/>

        <!-- Add GST after Description -->
        <xpath expr="//th[@name='th_description']" position="after">

             <th name="th_hsn_code"
                class="text-end">
                <span>HSN/SAC</span>
            </th>

            <th t-if="display_taxes"
                class="text-end"
                name="th_gst">
                GST
            </th>
        </xpath>

        <!-- ================= PRODUCT LINES ================= -->

        <!-- Remove original Taxes column -->
        <xpath expr="//td[@name='td_product_taxes']" position="replace"/>

        <!-- Insert GST after Description -->
        <xpath expr="//td[@name='td_product_name']" position="after">

             <!-- HSN/SAC -->
            <td name="td_hsn_code"
                class="text-end">
                <span t-field="line.l10n_in_hsn_code"/>
            </td>

            <td t-if="display_taxes"
                class="text-end"
                name="td_product_gst">

                <t t-set="gst"
                   t-value="', '.join(str(t.amount).rstrip('0').rstrip('.') + '%' for t in line.tax_ids)"/>

                <span t-esc="gst"/>

            </td>

        </xpath>

        <!-- ================= SECTION SUMMARY ================= -->

        <xpath expr="//td[@name='td_section_group_taxes']" position="replace"/>

        <xpath expr="//td[@name='td_section_group_name']" position="after">

            <td t-if="display_taxes"
                class="text-end"
                name="td_section_group_gst">

                <span t-out="', '.join(str(t).replace('IGST ','').replace('CGST ','').replace('SGST ','') for t in section_line['tax_labels'])"/>

            </td>

        </xpath>

    </template>

</odoo>