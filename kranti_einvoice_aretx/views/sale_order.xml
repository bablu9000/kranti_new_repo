<odoo>
    <record id="sale_order_form_transporter" model="ir.ui.view">
        <field name="name">sale.order.form.transporter</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <!-- WhatsApp Button -->
            <xpath expr="//header" position="inside">
                <button
                        name="action_open_whatsapp_composer"
                        type="object"
                        string="WhatsApp"
                        class="oe_highlight"/>
            </xpath>

            <!-- Hide Delivery Button -->
            <xpath expr="//button[@name='action_view_delivery']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <xpath expr="//field[@name='payment_term_id']" position="after">

                <field name="transporter_id" options="{'no_create': True, 'no_create_edit': True}"/>

                <field name="booking_name"/>
                <field name="kppl_number"/>
                <field name="boxes"/>
                <field name="bags"/>
                <field name="total" readonly="True"/>

            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="move"/>
                <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_id']" position="move"/>
                <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="move"/>
                <xpath expr="//field[@name='order_line']/list/field[@name='tax_ids']" position="move"/>
                <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="move"/>
                <xpath expr="//field[@name='order_line']/list/field[@name='qty_delivered']" position="move"/>
                <xpath expr="//field[@name='order_line']/list/field[@name='qty_invoiced']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="before">
                <field name="l10n_in_hsn_code"
                       string="HSN/SAC Code"
                       optional="show"
                       readonly="1"
                       invisible="parent.country_code != 'IN'"/>
            </xpath>
        </field>
    </record>

    <!-- Quotation List - Total Packages -->
    <record id="quotation_list_view_total_packages" model="ir.ui.view">
        <field name="name">quotation.list.view.total.packages</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//list/field[@name='amount_total']" position="before">
                <field name="total"
                       string="Total Pkgs"
                       optional="show"/>
            </xpath>

        </field>
    </record>


    <record id="sale_order_disable_line_creation" model="ir.ui.view">
        <field name="name">sale.order.disable.line.creation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Hide Add Product after confirmation -->
            <xpath expr="//field[@name='order_line']/list/control/create[@name='add_product_control']"
                   position="attributes">
                <attribute name="invisible">parent.state in ['sale', 'cancel']</attribute>
            </xpath>

            <!-- Hide Add Section after confirmation -->
            <xpath expr="//field[@name='order_line']/list/control/create[@name='add_section_control']"
                   position="attributes">
                <attribute name="invisible">parent.state in ['sale', 'cancel']</attribute>
            </xpath>

            <!-- Hide Add Note after confirmation -->
            <xpath expr="//field[@name='order_line']/list/control/create[@name='add_note_control']"
                   position="attributes">
                <attribute name="invisible">parent.state in ['sale', 'cancel']</attribute>
            </xpath>

            <!-- Hide Catalog after confirmation -->
            <xpath expr="//field[@name='order_line']/list/control/button[@name='action_add_from_catalog']"
                   position="attributes">
                <attribute name="invisible">parent.state in ['sale', 'cancel']</attribute>
            </xpath>

        </field>
    </record>

    <!-- report -->
    <template id="sale_order_report_transporter"
              inherit_id="sale.report_saleorder_document">

        <!-- Reduce overall report size -->
        <xpath expr="//div[contains(@class, 'page')]" position="inside">
            <style>
                .page {
                font-size: 12px !important;
                }

                .page table {
                font-size: 12px !important;
                }

                .page td,
                .page th {
                padding: 3px 4px !important;
                }

                .page p {
                margin-bottom: 3px !important;
                }

                .page .row {
                margin-bottom: 3px !important;
                }
            </style>
        </xpath>

        <xpath expr="//div[@id='informations']/div[last()]" position="after">

            <div class="col">
                <strong>Transporter</strong>
                <div t-if="doc.transporter_id" t-field="doc.transporter_id"/>
            </div>

            <div class="col">
                <strong>Booking Name</strong>
                <div t-if="doc.booking_name" t-field="doc.booking_name"/>
            </div>

            <div class="col">
                <strong>KPPL Order No.</strong>
                <div t-if="doc.kppl_number" t-field="doc.kppl_number"/>
            </div>

            <div class="col">
                <strong>No. of Packages</strong>
                <div>
                    <span t-esc="doc.boxes"/>
                    [Boxes] +
                    <span t-esc="doc.bags"/>
                    [Bags] =
                    <span t-esc="doc.total"/>
                </div>
            </div>

        </xpath>

        <xpath expr="//div[@name='so_total_summary']" position="after">

            <t t-if="doc.company_id.account_fiscal_country_id.code == 'IN' and doc.company_id.l10n_in_is_gst_registered">
                <t t-set="hsn_summary" t-value="doc._l10n_in_get_hsn_summary_table()"/>
                <t t-if="hsn_summary">
                    <div name="l10n_in_hsn_summary" class="mt-3" style="page-break-inside: avoid;">
                        <h4>HSN Summary</h4>
                        <table class="table table-sm table-borderless col-6">
                            <thead>
                                <th>HSN/SAC</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Rate %</th>
                                <th class="text-end">Taxable Value</th>
                                <th class="text-end" t-if="hsn_summary['has_gst']">SGST/UTGST</th>
                                <th class="text-end" t-if="hsn_summary['has_gst']">CGST</th>
                                <th class="text-end" t-if="hsn_summary['has_igst']">IGST</th>
                                <th class="text-end" t-if="hsn_summary['has_cess']">CESS</th>
                            </thead>
                            <tr t-foreach="hsn_summary['items']" t-as="item">
                                <td t-esc="item['l10n_in_hsn_code']"/>
                                <td class="text-end">
                                    <span t-esc="item['quantity']"/>
                                    <span t-if="hsn_summary['display_uom']">(<t t-esc="item['uom_name']"/>)
                                    </span>
                                </td>
                                <td class="text-end" t-esc="item['rate']"/>
                                <td class="text-end">
                                    <span t-esc="item['amount_untaxed']"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                                <td class="text-end" t-if="hsn_summary['has_gst']">
                                    <span t-esc="item['tax_amount_sgst']"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                                <td class="text-end" t-if="hsn_summary['has_gst']">
                                    <span t-esc="item['tax_amount_cgst']"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                                <td class="text-end" t-if="hsn_summary['has_igst']">
                                    <span t-esc="item['tax_amount_igst']"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                                <td class="text-end" t-if="hsn_summary['has_cess']">
                                    <span t-esc="item['tax_amount_cess']"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>


            <!-- Bank Details -->
