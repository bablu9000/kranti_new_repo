<odoo>

    <record id="view_l10n_in_ewaybill_form_inherit_transporter" model="ir.ui.view">

        <field name="name">l10n.in.ewaybill.form.inherit.transporter</field>

        <field name="model">l10n.in.ewaybill</field>

        <field name="inherit_id" ref="l10n_in_ewaybill.l10n_in_ewaybill_form_view"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='transporter_id']" position="attributes">

                <attribute name="domain">[('id', 'in', partner_bill_to_id.transporter_ids)]</attribute>

            </xpath>

            <xpath expr="//field[@name='transporter_id']"
                    position="replace">

                    <field name="available_transporter_ids"
                        invisible="1"/>

                    <field name="transporter_id"
                        domain="[('id', 'in', available_transporter_ids)]"
                        readonly="False"
                        required="not mode"
                        options="{'no_create': True, 'no_create_edit': True}"/>

                </xpath>

        </field>

    </record>

</odoo>