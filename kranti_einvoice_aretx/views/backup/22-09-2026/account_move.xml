<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_move_form" model="ir.ui.view">
        <field name="name">view.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_in_edi_status']" position="after">

                <field name="boxes"/>
                <field name="bags"/>
                <field name="total" readonly="True"/>

            </xpath>
            <xpath expr="//field[@name='l10n_in_gst_treatment']" position="after">
                <field name="transporter_id"/>
                <field name="vehicle_num"/>
                <field name="booking_name"/>
                <field name="kppl_number"/>
                <field name="lr_no"/>
                <field name="lr_date"/>
            </xpath>

            <xpath expr="//header" position="inside">
                <button
                        name="action_generate_einvoice"
                        type="object"
                        string="Generate E-Invoice"
                        class="oe_highlight"
                        invisible="not l10n_in_ewaybill_ids"/>

                <button
                        name="action_open_whatsapp_composer"
                        type="object"
                        string="WhatsApp"
                        class="oe_highlight"/>

            </xpath>
            <xpath expr="//field[@name='l10n_in_gst_treatment']" position="after">

                <field name="l10n_in_ewaybill_name"
                       string="E-Waybill No."
                       invisible="not l10n_in_ewaybill_name"
                       readonly="1"/>

            </xpath>
            <!-- Column Sequencing -->
            <!-- Quantity immediately after Product -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
                   position="after">
                <field name="quantity" position="move"/>
                <field name="price_unit" position="move"/>
                <field name="product_uom_id" position="move"/>
                <field name="discount" position="move"/>
                <field name="tax_ids" position="move"/>
                <field name="price_subtotal" position="move"/>
            </xpath>
        </field>
    </record>

    <!-- List View -->
    <record id="invoice_list_view_additional_columns" model="ir.ui.view">
        <field name="name">invoice.list.view.additional.columns</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="booking_name" optional="show"/>
                <field name="kppl_number" optional="show"/>
                <field name="transporter_id" optional="show"/>
                <field name="lr_no" optional="show"/>
                <field name="lr_date" optional="show"/>
            </xpath>
            <xpath expr="//list/field[@name='amount_total_in_currency_signed']" position="after">

                <field name="total"
                       string="Total Pkgs"
                       optional="show"/>

                <field name="whatsapp_sent"
                       string="WhatsApp Sent"
                       optional="show"/>

            </xpath>
        </field>
    </record>

    <template id="report_invoice_document_kppl"
              inherit_id="account.report_invoice_document">

        <!-- Reduce standard Odoo invoice font size -->
        <xpath expr="//div[contains(@class, 'invoice_main')]" position="attributes">
            <attribute name="style">
                font-size: 14px !important;
            </attribute>
        </xpath>

        <!-- Reduce invoice information section -->
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="style">
                font-size: 14px !important;
            </attribute>
        </xpath>

        <!-- Reduce invoice line table -->
        <xpath expr="//table[@name='invoice_line_table']" position="attributes">
            <attribute name="style">
                font-size: 12px !important;
            </attribute>
        </xpath>

        <!-- Reduce totals table -->
        <xpath expr="//table[contains(@class, 'o_total_table')]" position="attributes">
            <attribute name="style">
                font-size: 12px !important;
            </attribute>
        </xpath>

        <!-- Your existing KPPL Number -->
        <xpath expr="//div[@name='due_date']" position="after">

            <div class="col" name="kppl_number">
                <strong>KPPL Number</strong>
                <div t-field="o.kppl_number"/>
            </div>
            <div class="col" name="ewaybill_date">
                <strong>E-Way Bill Date</strong>
                <div t-esc="o.l10n_in_ewaybill_expiry_date or ''"/>
            </div>

        </xpath>

    </template>
</odoo>

