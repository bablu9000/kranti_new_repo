<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_account_move_form" model="ir.ui.view">
        <field name="name">view.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='l10n_in_edi_status']" position="after">

                <field name="boxes"/>
                <field name="bags"/>
                <field name="total" readonly="True"/>

            </xpath>

            <xpath expr="//field[@name='l10n_in_gst_treatment']" position="after">
                <field name="transporter_id"/>
                <field name="vehicle_num"/>
                <field name="booking_name"/>
                <field name="kppl_number"/>
                <field name="lr_no"/>
                <field name="lr_date"/>
            </xpath>

            <xpath expr="//header" position="inside">

                <button
                    name="action_generate_einvoice"
                    type="object"
                    string="Generate E-Invoice"
                    class="oe_highlight"
                    invisible="not l10n_in_ewaybill_ids"/>

                <button
                    name="action_open_whatsapp_composer"
                    type="object"
                    string="WhatsApp"
                    class="oe_highlight"/>

            </xpath>

            <xpath expr="//field[@name='l10n_in_gst_treatment']" position="after">

                <field name="l10n_in_ewaybill_name"
                       string="E-Waybill No."
                       invisible="not l10n_in_ewaybill_name"
                       readonly="1"/>

            </xpath>

            <!-- Column Sequencing -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
                   position="after">

                <field name="quantity" position="move"/>
                <field name="price_unit" position="move"/>
                <field name="product_uom_id" position="move"/>
                <field name="discount" position="move"/>
                <field name="tax_ids" position="move"/>
                <field name="price_subtotal" position="move"/>

            </xpath>

        </field>
    </record>


    <!-- List View -->
    <record id="invoice_list_view_additional_columns" model="ir.ui.view">
        <field name="name">invoice.list.view.additional.columns</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//list" position="inside">

                <field name="booking_name" optional="show"/>
                <field name="kppl_number" optional="show"/>
                <field name="transporter_id" optional="show"/>
                <field name="lr_no" optional="show"/>
                <field name="lr_date" optional="show"/>

            </xpath>

            <xpath expr="//list/field[@name='amount_total_in_currency_signed']"
                   position="after">

                <field name="total"
                       string="Total Pkgs"
                       optional="show"/>

                <field name="whatsapp_sent"
                       string="WhatsApp Sent"
                       optional="show"/>

            </xpath>

        </field>
    </record>


    <!-- Invoice PDF -->
    <template id="report_invoice_document_kppl"
              inherit_id="account.report_invoice_document">

        <!-- ========================================================= -->
        <!-- REDUCE OVERALL INVOICE PDF SIZE                           -->
        <!-- ========================================================= -->

        <xpath expr="//div[contains(@class, 'page')]" position="inside">

            <style>

                .page {
                    font-size: 12px !important;
                }

                .page table {
                    font-size: 12px !important;
                }

                .page td,
                .page th {
                    padding: 3px 4px !important;
                }

                .page p {
                    margin-bottom: 3px !important;
                }

                .page .row {
                    margin-bottom: 3px !important;
                }

                .page #informations {
                    font-size: 12px !important;
                }

                .page .invoice_main {
                    font-size: 12px !important;
                }

                .page table[name="invoice_line_table"] {
                    font-size: 12px !important;
                }

                .page .o_total_table {
                    font-size: 12px !important;
                }

                /* Remove HSN Summary heading only */
                .page div[name="l10n_in_hsn_summary"] h4 {
                    display: none !important;
                }

                .address {
                    display: none !important;
                }

            </style>

        </xpath>
        

        <!-- ========================================================= -->
        <!-- HIDE ORIGINAL ODOO CUSTOMER ADDRESS                      -->
        <!-- ========================================================= -->

        <xpath expr="//div[@name='address_not_same_as_shipping']"
            position="attributes">

            <attribute name="style">
                display: none !important;
            </attribute>

        </xpath>

        <xpath expr="//div[@name='address_same_as_shipping']"
            position="attributes">

            <attribute name="style">
                display: none !important;
            </attribute>

        </xpath>

        <xpath expr="//div[@name='no_shipping']"
            position="attributes">

            <attribute name="style">
                display: none !important;
            </attribute>

        </xpath>

        <!-- ========================================================= -->
        <!-- CLIENT INVOICE HEADER BOX                                 -->
        <!-- ========================================================= -->

        <xpath expr="//div[@id='informations']"
            position="before">

            <table class="kppl_invoice_header"
                style="
                    width: 100%;
                    border-collapse: collapse;
                    table-layout: fixed;
                    margin: 0 0 8px 0;
                    padding: 0;
                    font-size: 11px;
                ">

                <tbody>
                    <tr>

                        <!-- ================================================= -->
                        <!-- LEFT: CUSTOMER DETAILS                            -->
                        <!-- ================================================= -->

                        <td style="
                            width: 35%;
                            border: 1px solid #8d8989;
                            padding: 6px 8px;
                            vertical-align: top;
                            height: 135px;
                        ">

                            <strong t-field="o.partner_id"/>

                            <div t-if="o.partner_id.street">
                                <span t-field="o.partner_id.street"/>
                            </div>

                            <div t-if="o.partner_id.street2">
                                <span t-field="o.partner_id.street2"/>
                            </div>

                            <div>
                                <span t-field="o.partner_id.city"/>

                                <t t-if="o.partner_id.zip">
                                    <span> </span>
                                    <span t-field="o.partner_id.zip"/>
                                </t>
                            </div>

                            <div t-if="o.partner_id.state_id">
                                <span t-field="o.partner_id.state_id"/>
                            </div>

                            <div t-if="o.partner_id.country_id">
                                <span t-field="o.partner_id.country_id"/>
                            </div>

                            <div t-if="o.partner_id.vat"
                                style="margin-top: 3px;">
                                <strong>GSTIN:</strong>
                                <span t-field="o.partner_id.vat"/>
                            </div>

                            <div t-if="o.partner_id.state_id"
                                style="margin-top: 3px;">
                                <strong>Place of supply:</strong>
                                <span t-field="o.partner_id.state_id"/>
                            </div>

                        </td>


                        <!-- ================================================= -->
                        <!-- MIDDLE: INVOICE DETAILS                           -->
                        <!-- ================================================= -->

                        <td style="
                            width: 40%;
                            border: 1px solid #8d8989;
                            padding: 6px 8px;
                            vertical-align: top;
                            height: 135px;
                        ">

                            <div>
                                <strong>Invoice No :</strong>
                                <span t-field="o.name"/>
                            </div>

                            <div>
                                <strong>Date :</strong>
                                <span t-field="o.invoice_date"/>
                            </div>

                            <div>
                                <strong>Order No :</strong>
                                <span t-field="o.invoice_origin"/>
                            </div>

                            <div>
                                <strong>Total Pkgs :</strong>

                                <span t-esc="o.boxes"/>
                                [Box] +

                                <span t-esc="o.bags"/>
                                [Bag]

                                =

                                <span t-esc="o.total"/>
                            </div>
                            <div>
                                <strong>KPPL No :</strong>
                                <span t-field="o.kppl_number"/>
                            </div>
                            <div>
                                <strong>LR No :</strong>
                                <span t-field="o.lr_no"/>
                            </div>
                            <div>
                                <strong>LR Date :</strong>
                                <span t-field="o.lr_date"/>
                            </div>
                            <t t-set="ewaybill"
                        t-value="o.l10n_in_ewaybill_ids.filtered(lambda e: e.state == 'generated')[:1]"/>

                        <div>
                            <strong>E-Waybill :</strong>
                            <span t-esc="ewaybill.name if ewaybill else ''"/>
                        </div>

                        <div>
                            <strong>E-Waybill Date :</strong>
                            <span t-if="ewaybill"
                                t-field="ewaybill.ewaybill_date"/>
                        </div>

                        </td>


                        <!-- ================================================= -->
                        <!-- RIGHT: IRN / QR / ACKNOWLEDGEMENT                 -->
                        <!-- ================================================= -->

                        <t t-set="edi_json"
                        t-value="o._get_l10n_in_edi_response_json() or {}"/>

                        <td style="
                            width: 25%;
                            border: 1px solid #8d8989;
                            padding: 6px 8px;
                            vertical-align: top;
                            height: 135px;
                            text-align: center;
                        ">

                            <!-- IRN -->
                            <div>
                                <strong>IRN NO</strong>
                            </div>

                            <div>
                                <span t-esc="edi_json.get('Irn', '')"/>
                            </div>

                            <!-- E-INVOICE QR -->
                            <t t-if="edi_json.get('SignedQRCode')">

                                <div style="
                                    margin-top: 5px;
                                    margin-bottom: 5px;
                                    text-align: center;
                                ">

                                    <img
                                        t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s'
                                            % ('QR', edi_json['SignedQRCode'], 500, 500, 0)"
                                        style="
                                            width: 70px;
                                            height: 70px;
                                            display: inline-block;
                                        "
                                    />

                                </div>

                            </t>

                            <!-- ACKNOWLEDGEMENT NUMBER -->
                            <div>
                                <strong>Acknowledgement No.</strong>
                            </div>

                            <div>
                                <span t-esc="edi_json.get('AckNo', '')"/>
                            </div>

                        </td>

                    </tr>
                </tbody>

            </table>

        </xpath>

        <xpath expr="//div[@id='informations']"
            position="attributes">

            <attribute name="style">
                display: none !important;
            </attribute>

        </xpath>  

    </template>

    <!-- ========================================================= -->
    <!-- CHANGE INVOICE TOTAL LABELS IN PDF                       -->
    <!-- ========================================================= -->

    <template id="custom_document_tax_totals"
            inherit_id="account.document_tax_totals_template"
            priority="100">

        <!-- Untaxed Amount → Amount -->
        <xpath expr="//tr[contains(@class, 'o_subtotal')]/td[1]/span"
            position="replace">
            <span>Amount</span>
        </xpath>

        <!-- Total → Total with Tax Amount -->
        <xpath expr="//tr[contains(@class, 'o_total')]/td[1]/strong"
            position="replace">
            <strong>Total with Tax Amount</strong>
        </xpath>

    </template>

    <!-- ========================================================= -->
    <!-- REMOVE STANDARD E-INVOICE IRN + QR                       -->
    <!-- They are displayed in our custom invoice header instead. -->
    <!-- ========================================================= -->

    <template id="hide_standard_einvoice_irn_qr"
            inherit_id="account.report_invoice_document"
            priority="200">

        <xpath expr="//div[@id='right-elements']/following-sibling::div[
            .//strong[normalize-space()='IRN:']
        ]"
            position="replace"/>

    </template>

    <template id="report_invoice_hsn_position"
                inherit_id="l10n_in.l10n_in_report_invoice_document_inherit"
                priority="100">

            <!-- Move HSN HEADER after Description -->
        <xpath expr="//table[@name='invoice_line_table']/thead/tr/th[@name='th_description']"
            position="after">

            <xpath expr="//table[@name='invoice_line_table']/thead/tr/t[th[normalize-space()='HSN/SAC']]"
                position="move"/>

        </xpath>


        <!-- Move HSN BODY CELL after Description -->
        <xpath expr="//t[@name='account_invoice_line_accountable']/td[@name='account_invoice_line_name']"
            position="after">

            <xpath expr="//t[@name='account_invoice_line_accountable']/td[.//span[@t-field='line.l10n_in_hsn_code']]"
                position="move"/>

        </xpath>

    </template>

    <template id="remove_payment_communication"
              inherit_id="l10n_in.l10n_in_report_invoice_document_inherit"
              priority="999">

        <xpath expr="//p[@name='payment_communication']" position="replace"/>

        <!-- Move the existing "comment" (Terms and Conditions) div
             to sit right after the HSN summary table -->
        <xpath expr="//div[@name='l10n_in_hsn_summary']" position="after">
            <xpath expr="//div[@name='comment']" position="move"/>
        </xpath>

    </template>


</odoo>