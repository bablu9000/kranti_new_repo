<odoo>
    <record id="view_account_journal_form_bank_branch" model="ir.ui.view">
        <field name="name">account.journal.form.bank.branch</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='bank_account_id']"
                position="after">

                <field name="bank_branch">Bank Branch</field>

            </xpath>

        </field>
    </record>
</odoo>