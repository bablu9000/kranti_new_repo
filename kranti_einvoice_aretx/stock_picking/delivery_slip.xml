<odoo>
    <template id="report_delivery_document_transporter"
            inherit_id="stock.report_delivery_document">

        <xpath expr="//div[@id='informations']/div[@name='div_sched_date']"
            position="after">

            <div class="col col-3 mw-100 mb-2"
                t-if="o.sale_id.transporter_id"
                name="div_transporter">
                <strong>Transporter</strong>
                <div t-field="o.sale_id.transporter_id"/>
            </div>

            <div class="col col-3 mw-100 mb-2"
                t-if="o.sale_id.booking_name"
                name="div_booking_name">
                <strong>Booking Name</strong>
                <div t-field="o.sale_id.booking_name"/>
            </div>

            <div class="col col-3 mw-100 mb-2"
                t-if="o.sale_id.kppl_number"
                name="div_kppl_number">
                <strong>KPPL Order No.</strong>
                <div t-field="o.sale_id.kppl_number"/>
            </div>

        </xpath>

    </template>

    <record id="stock_picking_kppl" model="ir.ui.view">
        <field name="name">stock.picking.kppl</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']" position="before">
                <field name="kppl_number"/>
            </xpath>
        </field>
    </record>
</odoo>