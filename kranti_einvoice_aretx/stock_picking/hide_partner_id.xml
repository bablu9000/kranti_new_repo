<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List Type -->
    <record id="hide_partner_list" model="ir.ui.view">
        <field name="name">stock.picking.list.hide.partner</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="groups">stock.group_stock_manager</attribute>
            </xpath>
        </field>
    </record>
    <!-- Form Type -->
    <record id="hide_partner_form" model="ir.ui.view">
        <field name="name">stock.picking.form.hide.partner</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id' and @nolabel='1']"
                position="attributes">
                <attribute name="groups">stock.group_stock_manager</attribute>
            </xpath>

            <xpath expr="//div[contains(@class, 'o_td_label')]"
                position="attributes">
                <attribute name="groups">stock.group_stock_manager</attribute>
            </xpath>
        </field>
    </record>
</odoo>