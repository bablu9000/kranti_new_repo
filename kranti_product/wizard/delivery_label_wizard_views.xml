<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="delivery_label_wizard_form_view" model="ir.ui.view">
        <field name="name">delivery.label.wizard.form</field>
        <field name="model">delivery.label.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Delivery Label">
                <group>
                    <field name="order_no"/>
                    <field name="transport_name"/>
                    <field name="total_carton"/>
                </group>
                <footer>
                    <button name="action_print_delivery_label" string="Print Label"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
