<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- NEW: report action for product.label.wizard -->
    <record id="action_report_product_label" model="ir.actions.report">
        <field name="name">Product Custom Label</field>
        <field name="model">product.label.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">kranti_product.report_product_label</field>
        <field name="report_file">kranti_product.report_product_label</field>
        <field name="print_report_name">'Product Label - %s' % (object.product_template_id.name)</field>
        <field name="paperformat_id" ref="kranti_product.paperformat_label_15x10"/>
    </record>
</odoo>
