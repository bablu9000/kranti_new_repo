<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_custom_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="
                    width: 152.4mm;
                    height: 101.6mm;
                    font-family: Arial, sans-serif;
                    border: 1px solid #333;
                ">
                    <table style="width: 100%; height: 100%; border-collapse: collapse;">
                        <tr>
                            <td colspan="2" style="
                                border-bottom: 2px solid #000;
                                padding: 8px 12px;
                            ">
                                <img t-if="doc.env.company.logo" t-att-src="image_data_uri(doc.env.company.logo)"
                                     style="max-height: 50px;"/>
                            </td>
                        </tr>
                        <tr style="height: 100%;">
                            <td style="
                                width: 65%;
                                padding: 0;
                                font-size: 12px;
                            ">
                                <table style="width: 100%; height: 100%; border-collapse: collapse;">
                                    <tr style="height: 16.66%;">
                                        <td style="vertical-align: middle; padding-left: 10px;"><strong>ITEM NAME :</strong> <span t-field="doc.product_id.name"/></td>
                                    </tr>
                                    <tr style="height: 16.66%;">
                                        <td style="vertical-align: middle; padding-left: 10px;"><strong>ITEM CODE :</strong> <span t-field="doc.ref"/></td>
                                    </tr>
                                    <tr style="height: 16.66%;">
                                        <td style="vertical-align: middle; padding-left: 10px;"><strong>SIZE :</strong> <span t-field="doc.product_id.size"/></td>
                                    </tr>
                                    <tr style="height: 16.66%;">
                                        <td style="vertical-align: middle; padding-left: 10px;"><strong>QUANTITY :</strong> <span t-field="doc.product_qty"/></td>
                                    </tr>
                                    <tr style="height: 16.66%;">
                                        <td style="vertical-align: middle; padding-left: 10px;"><strong>BATCH NO. :</strong> <span t-field="doc.name"/></td>
                                    </tr>
                                    <tr style="height: 16.66%;">
                                        <td style="vertical-align: middle; padding-left: 10px;"><strong>MRP OF BAG :</strong> <span t-esc="doc.product_id.list_price"/></td>
                                    </tr>
                                </table>
                            </td>
                            <td style="
                                width: 35%;
                                padding: 0;
                                vertical-align: middle;
                                text-align: center;
                            ">
                                <img t-if="doc.product_id.product_tmpl_id.image_256"
                                     t-att-src="image_data_uri(doc.product_id.product_tmpl_id.image_256)"
                                     style="max-width: 100%; max-height: 54mm;"/>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="
                                border-top: 1px solid #000;
                                padding: 2px 8px 4px;
                                font-size: 9px;
                                line-height: 1.25;
                            ">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="width: 15%; text-align: left; font-size: 8px;">
                                            <strong>MFG. BY :-</strong>
                                        </td>
                                        <td style="width: 70%; text-align: center; font-size: 10px;">
                                            <u>
                                                <strong><span t-esc="doc.env.company.name or ''"/></strong>
                                            </u>
                                        </td>
                                        <td style="width: 15%;"></td>
                                    </tr>
                                </table>
                                <div style="text-align: center; font-size: 8px;">
                                    Corporate Office &amp; Unit : <span t-esc="doc.env.company.street or ''"/>
                                </div>
                                <div style="border-top: 1px solid #999; margin: 2px 0;"></div>
                                <div style="text-align: center; font-size: 8px;">
                                    Email ID : <span t-esc="doc.env.company.email or ''"/>
                                    | Web : <span t-esc="doc.env.company.website or ''"/>
                                    | Customer Care No. : 9825094700
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
