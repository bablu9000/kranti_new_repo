<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_label">
        <t t-call="web.html_container">
            <style>
                @page {
                    margin: 0 !important;
                    padding: 0 !important;
                }
                html, body {
                    margin: 0 !important;
                    padding: 0 !important;
                }
                .page {
                    margin: 0 !important;
                    padding: 0 !important;
                }
            </style>
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="
                    width: 100%;
                    height: 100%;
                    font-family: Arial, sans-serif;
                    border: 1px solid #333;
                    box-sizing: border-box;
                ">
                    <table style="width: 100%; height: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="
                                border-bottom: 1px solid #000;
                                padding: 2px 3px;
                            ">
                                <img t-if="doc.env.company.logo" t-att-src="image_data_uri(doc.env.company.logo)"
                                     style="max-height: 40px;"/>
                            </td>
                        </tr>
                        <tr style="height: 100%;">
                            <td style="
                                padding: 0;
                                font-size: 9pt !important;
                            ">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="vertical-align: top; padding: 20px 4px; font-size: 9pt !important;"><strong>ORDER NO :</strong> <span t-field="doc.order_no"/></td>
                                    </tr>
                                    <tr>
                                        <td style="vertical-align: top; padding: 20px 4px; font-size: 9pt !important;"><strong>TRANSPORT :</strong> <span t-field="doc.transport_name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="vertical-align: top; padding: 20px 4px; font-size: 9pt !important;"><strong>CARTON :</strong> <span t-field="doc.total_carton"/></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td style="
                                border-top: 1px solid #000;
                                padding: 1px 2px 1px;
                                font-size: 10px !important;
                                line-height: 1.25;
                            ">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="width: 15%; text-align: left; font-size: 5px !important;">
                                            <strong>MFG. BY :-</strong>
                                        </td>
                                        <td style="width: 70%; text-align: center; font-size: 10px !important;">
                                            <u>
                                                <strong><span t-esc="doc.env.company.name or ''"/></strong>
                                            </u>
                                        </td>
                                        <td style="width: 15%;"></td>
                                    </tr>
                                </table>
                                <div style="text-align: center; font-size: 8px !important;">
                                    <span t-esc="doc.env.company.street or ''"/>
                                </div>
                                <div style="border-top: 1px solid #999; margin: 1px 0;"></div>
                                <div style="text-align: center; font-size: 8px !important;">
                                    <span t-esc="doc.env.company.email or ''"/>
                                    | <span t-esc="doc.env.company.website or ''"/>
                                    | 9825094700
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
