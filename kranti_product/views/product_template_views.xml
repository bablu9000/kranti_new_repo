<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- KEEP: existing inheritance of product.product_template_form_view for size/label fields -->
    <record id="kranti_product_template_form_view" model="ir.ui.view">
        <field name="name">kranti.product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='show_qty_update_button']" position="after">
                <field name="size" placeholder="e.g. M, 10x15cm, XL"/>
                <field name="product_label"/>
            </xpath>
        </field>
    </record>

    <!-- NEW: stat button on product_template_only_form_view to open label wizard -->
    <record id="kranti_product_template_only_form_view" model="ir.ui.view">
        <field name="name">kranti.product.template.only.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_print_product_label"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-print">
                    <span class="o_stat_text">Print Label</span>
                </button>
            </div>
        </field>
    </record>

    <record id="action_kranti_print_product_label" model="ir.actions.server">
        <field name="name">Custom Print Label</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="sequence">20</field>
        <field name="state">code</field>
        <field name="code">action = records.action_print_product_label()</field>
    </record>
</odoo>
