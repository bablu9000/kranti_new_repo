<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	
	<record id="view_sale_order_kranti_form" model="ir.ui.view">
        <field name="name">sale.order.kranti.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="transport_id"/>
                <field name="vehicle"/>
                <field name="package"/>
                <field name="lr"/>
                <field name="lr_date"/>
            </xpath>
            <xpath expr="//list/field[@name='product_uom_qty']" position="before">
                <field name="box_qty" optional="show"/>
                <field name="box_product_uom_id" optional="show"/>
            </xpath>
            <xpath expr="//list/field[@name='product_uom_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_company_form_msme" model="ir.ui.view">
        <field name="name">res.company.form.msme</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="udyam"/>                    
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_msme" model="ir.ui.view">
        <field name="name">res.partner.form.msme</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='function']" position="after">
                <label for="msme" string="MSME No"/>
                <div class="o_row">
                    <field name="msme"/>
                </div>
            </xpath>
        </field>
    </record>

    <template id="report_saleorder_add_box_package" inherit_id="sale.report_saleorder_document">
        <xpath expr="//table[contains(@class,'table') and contains(@class,'o_main_table')]/thead/tr/th[@name='th_description']" position="after">
            <th name="th_code" style="width:80px;">Code</th>
            <th name="th_box_qty" style="width:80px;">Box Qty</th>
            <th name="th_package" class="text-center">Package</th>
        </xpath>
        <xpath expr="//t[contains(@t-foreach,'lines_to_report')]//tr/td[@name='td_product_quantity']" position="before">
            <td class="text-center"><span t-esc="line.product_id.barcode or line.product_id.default_code or ''"/></td>
            <td class="text-center"><span t-esc="line.box_qty or ''"/></td>
            <td class="text-center"><span t-esc="line.box_product_uom_id.name or ''"/></td>
        </xpath>
    </template>

</odoo>