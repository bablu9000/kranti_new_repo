    <field name="report_type">qweb-pdf</field>
    <field name="report_name">kranti_report.report_invoice_pdf</field>
    <field name="report_file">kranti_report.report_invoice_pdf</field>
    <field name="print_report_name">'Invoice - %s' % (object.name)</field>
