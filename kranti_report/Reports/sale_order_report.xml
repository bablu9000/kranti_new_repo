<odoo>
  <template id="report_quotation_pdf">    
    <t t-call="web.html_container">     
      <t t-call="kranti_report.external_layout_boxed_custom_quotation">
        <div class="page">
            <tr>
                <td style="width: 50%; ">
                    <span><center><strong><b style="font-size:25px;">QUOTATION</b></strong></center></span><br/>
                    <table style="width:100%; border-collapse:collapse; border:2px solid black; border-bottom:none;">
                        <tr>
                            <td style="width:38%; vertical-align:top;">
                                <b style="font-weight:bold;">Buyer :</b>
                                <b><t t-esc="docs[0].partner_id.name"/></b><br/>
                                <t t-esc="docs[0].partner_id.street"/><br/>
                                <t t-esc="docs[0].partner_id.city"/>
                                <t t-esc="docs[0].partner_id.zip"/><br/>
                                <t t-esc="docs[0].partner_id.state_id.name"/>
                                <t t-esc="docs[0].partner_id.country_id.name"/><br/>
                                <span style="display:inline-block; width:100px;"><b>STATE</b></span> :
                                <t t-esc="docs[0].partner_id.state_id.name"/>
                                <br/>
                                <span style="display:inline-block; width:100px;"><b>GSTIN/UIN</b></span> :
                                <t t-esc="docs[0].partner_id.vat or ''"/>
                                <br/>
                                <span style="display:inline-block; width:100px;"><b>PAN No</b></span> :
                                <t t-esc="docs[0].partner_id.l10n_in_pan_entity_id.name or ''"/>
                                <br/>
                                <span style="display:inline-block; width:100px;"><b>MSME No</b></span> :
                                <t t-esc="docs[0].partner_id.msme or ''"/>
                            </td>

                            <!--<td style="width:2%; border-left:2px solid black;"/>-->

                            <td style="width:60%; vertical-align:top;">
                                <table style="width:100%; padding: 0px;border-bottom:none; border-top:none; border-left:none; border-right:none;">
                                    <span style="display:inline-block; width:100px;"><b>IRN</b></span> :
                                    <t/><br/>

                                    <span style="display:inline-block; width:100px;"><b>Ack No.</b></span> :
                                    <span style="display:inline-block; width:170px;">
                                        <t/>
                                    </span>
                                    
                                    <span style="display:inline-block; width:100px;"><b>Ack Date</b></span> :
                                    <t/>
                                    <!-- <span t-field="docs[0].date_order" t-options="{'widget': 'date'}"/> -->
                                    <br/>
                                    <span style="display:inline-block; width:100px;"><b>Order No.</b></span> :
                                    <span style="display:inline-block; width:170px;">
                                        <t t-esc="docs[0].name"/>
                                    </span>
                                    
                                    <span style="display:inline-block; width:100px;"><b>Date</b></span> :
                                    <span t-field="docs[0].date_order" t-options="{'widget': 'date'}"/>
                                    <br/>
                                
                                    <span style="display:inline-block; width:150px;"><b>Payment Terms</b></span> :
                                    <t t-esc="docs[0].payment_term_id.name"/>
                                    <br/>
                                    <span style="display:inline-block; width:150px;"><b>Despatch Through</b></span> :
                                    <t t-esc="docs[0].transport"/>
                                    <br/>
                                </table>
                            </td>
                        </tr>
                    </table>
                    <table style="width:100%; border-collapse:collapse; border:2px solid black;">
                        <tr>
                            <td style="width:38%; vertical-align:top;">
                                <b style="font-weight:bold;">Consignee :</b>
                                <b><t t-esc="docs[0].partner_id.name"/></b><br/>
                                <t t-esc="docs[0].partner_id.street"/><br/>
                                <t t-esc="docs[0].partner_id.city"/>
                                <t t-esc="docs[0].partner_id.zip"/><br/>
                                <t t-esc="docs[0].partner_id.state_id.name"/>
                                <t t-esc="docs[0].partner_id.country_id.name"/><br/>
                                <span style="display:inline-block; width:100px;"><b>STATE</b></span> :
                                <t t-esc="docs[0].partner_id.state_id.name"/>
                                <br/>
                                <span style="display:inline-block; width:100px;"><b>GSTIN/UIN</b></span> :
                                <t t-esc="docs[0].partner_id.vat or ''"/>
                                <br/>
                                <span style="display:inline-block; width:100px;"><b>PAN No</b></span> :
                                <t t-esc="docs[0].partner_id.l10n_in_pan_entity_id.name or ''"/>
                                <br/>
                                <span style="display:inline-block; width:100px;"><b>MSME No</b></span> :
                                <t t-esc="docs[0].partner_id.msme or ''"/>
                                
                            </td>

                            <!--<td style="width:2%; border-left:2px solid black;"/>-->

                            <td style="width:60%; vertical-align:top;">
                                <table style="width:100%; padding: 0px; margin: 0px; border-bottom:none; border-top:none; border-left:none; border-right:none;">
                                    <span style="display:inline-block; width:100px;"><b>Bank Name</b></span> :
                                    <t t-esc="docs[0].partner_id.bank_ids[:1].bank_id.name"/>
                                    <br/>
                                    <span style="display:inline-block; width:100px;"><b>Branch Name</b></span> :
                                    <t t-esc="docs[0].partner_id.bank_ids[:1].bank_id.name"/>
                                    <br/>
                                    <span style="display:inline-block; width:100px;"><b>Bank A/c No</b></span> :
                                    <t t-esc="docs[0].partner_id.bank_ids[:1].acc_number"/>
                                    <br/>
                                    <span style="display:inline-block; width:100px;"><b>Bank IFS No</b></span> :
                                    <t t-esc="docs[0].partner_id.bank_ids[:1].bank_id.bic"/><br/>
                                    <hr/>
                                    <span style="display:inline-block; width:100px;"><b>Remarks</b></span> : <t t-esc="docs[0].note"/>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <table class="table table-sm border" style="width : 100%; margin:0px; border-spacing:0px; border:2px solid black;">
                        <thead>
                            <tr>
                                <th style="text-transform:none; height:30px; font-weight: bold;">Sr No.</th>
                                <th style="text-transform:none; height:30px; font-weight: bold;">Part No</th>
                                <th style="text-transform:none; height:30px; font-weight: bold;">Description of Goods</th>
                                <th style="text-transform:none; height:30px; font-weight: bold;">G-ST</th>
                                <th style="text-transform:none; height:30px; font-weight: bold;">Nos</th>
                                <th style="text-transform:none; height:30px; font-weight: bold;">Qty</th>
                                <th style="text-transform:none; height:30px; font-weight: bold;">Unit</th>
                                <th style="text-transform:none; height:30px; font-weight: bold;">Rate</th>
                                <th style="text-transform:none; height:30px; font-weight: bold;">Basic Value</th>
                            </tr>
                            <tr>
                                <td style="height:30px;"><b>A</b></td>

                                <td style="height:30px;">
                                </td>

                                <td style="height:30px;"><b>HSN Code :-
                                    <span t-esc="docs[0].order_line[0].product_id.l10n_in_hsn_code or ''"/></b>
                                </td>
                                <td style="height:30px;">
                                </td>

                                <td style="height:30px;">
                                </td>

                                <td style="height:30px;">
                                </td>

                                <td style="height:30px;">
                                </td>

                                <td style="height:30px;">
                                </td>
                                <td style="height:30px;">
                                </td>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="counter" t-value="1"/>
                            <t t-set="tot_qty" t-value="0"/>
                            <t t-set="tot_crt" t-value="0"/>
                            <t t-set="tot_amt" t-value="0"/>
                            <t t-foreach="docs.order_line" t-as="line">
                                <tr>
                                    <td style="height:30px;"><span t-esc="counter"/></td>

                                    <td style="height:30px;">
                                        <span t-esc="line.product_id.default_code"/>
                                    </td>

                                    <td style="height:30px;">
                                        <span t-esc="line.product_template_id.name"/>
                                    </td>
                                    <td style="height:30px;">
                                        <span t-esc="line.tax_ids.name"/>
                                    </td>

                                    <td style="height:30px;">
                                        <span t-esc="line.nos"/>
                                    </td>

                                    <td style="height:30px;">
                                        <span t-esc="line.product_uom_qty"/>
                                    </td>

                                    <td style="height:30px;">
                                        <span t-esc="line.product_uom_id.name"/>
                                    </td>

                                    <td style="height:30px;">
                                        <span t-esc="line.price_unit"/>
                                    </td>
                                    <td style="height:30px;">
                                        <span t-esc="line.price_subtotal"/>
                                    </td>
                                </tr>
                                <t t-set="counter" t-value="counter + 1"/>
                                <t t-set="tot_qty" t-value="tot_qty + (line.product_uom_qty or 0)"/>
                                <t t-set="tot_crt" t-value="tot_crt + (line.nos or 0)"/>
                                <t t-set="tot_amt" t-value="tot_amt + (line.price_subtotal or 0)"/>
                            </t>
                            <tr style="font-weight:bold;">
                                <td colspan="3"></td>
                                <td><b>Quantity Total</b></td>
                                <td><span t-esc="tot_crt"/></td>
                                <td><span t-esc="tot_qty"/></td>
                                <td></td>
                                <td><b>Total</b></td>
                                <td><span t-esc="tot_amt"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:100%; border-collapse:collapse; border:1px solid black; font-size:20px;">
                        <tr>
                            <th colspan="8"/>
                            <th colspan="8" style="border:1px solid black;">Taxable Value</th>
                            <th style="border:1px solid black;"/>
                            <th style="border:1px solid black;">Output IGST<t t-esc="int(sum(line.tax_ids.mapped('amount')))"/>%</th>
                            <th style="border:1px solid black; text-align:right;">
                                <span t-field="docs[0].amount_tax"/>
                            </th>
                        </tr>
                        <tr>
                            <td colspan="8"/>
                            <td  colspan="8" style="border:1px solid black; text-align:center;">
                                <span t-field="docs[0].amount_untaxed"/>
                            </td>
                            <td/>

                            <td style="border:1px solid black; text-align:center;">Round Off A/c ? Sales</td>
                            <td style="border:1px solid black; text-align:right;">
                                <span t-esc="(docs[0].amount_total - (docs[0].amount_untaxed + docs[0].amount_tax))"/>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="8"/>
                            <td colspan="8" style="border:1px solid black; text-align:center; font-weight:bold;">Total</td>

                            <td style="border:1px solid black; text-align:right; font-weight:bold;">
                                <span t-field="docs[0].amount_untaxed"/>
                            </td>
                            <td style="border:1px solid black; font-weight:bold; text-align:center;">Grand Total</td>
                            <td style="border:1px solid black; text-align:right; font-weight:bold;">
                                <span t-field="docs[0].amount_total"/>
                            </td>
                        </tr>
                    </table>
                    <table style="width:100%; border-collapse:collapse; border:1px solid black; font-size:14px;">
                        <tr>
                            <td style="width:70%; padding:6px;">
                                <b>Company’s GSTIN/UIN :</b> <t t-esc="docs[0].company_id.vat"/><br/>
                                <b>Company’s CIN No. :</b> <t t-esc="docs[0].company_id.company_registry"/><br/>
                                <b>Company’s PAN No. :</b> <t t-esc="docs[0].company_id.l10n_in_pan_entity_id.name"/><br/>
                                <b>UDYAM No. :</b> <t t-esc="docs[0].company_id.udyam"/><br/>
                            </td>
                            <td style="width:30%; border-left:1px solid black;"/>
                        </tr>
                    
                        <tr>
                            <td colspan="2" style="border-top:1px solid black; padding:6px;">
                                <b>Tax Value :</b>
                                <t t-esc="docs[0].currency_id.amount_to_text(docs[0].amount_tax)"/>
                            </td>
                        </tr>
                        
                        <tr>
                            <td colspan="2" style="border-top:1px solid black; padding:6px;">
                                <b>Invoice Value :</b>
                                <t t-esc="docs[0].currency_id.amount_to_text(docs[0].amount_total)"/>
                            </td>
                        </tr>

                    </table>

                    <table style="width:100%; border-collapse:collapse; border:1px solid black;">
                        <tr>
                            <td colspan="2" style="padding:6px;">
                                <b>Declaration :</b><br/>
                            </td>
                        </tr>
                    
                        <tr>
                            <td style="width:60%; height:80px; padding:6px;">
                                <b>Customer’s Seal and Signature</b>
                            </td>
                            <td style="width:40%; text-align:right; padding:6px;">
                                <b>For KRANTI POLYTECH PVT. LTD.</b><br/><br/>
                                <b>Authorised Signatory</b>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>                  
        </div>
      </t>
    </t>
  </template>

  <record id="action_report_quotation" model="ir.actions.report">
    <field name="name">Print Quotation </field>
    <field name="model">sale.order</field>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">kranti_report.report_quotation_pdf</field>
    <field name="report_file">kranti_report.report_quotation_pdf</field>
    <field name="print_report_name">'Quotation - %s' % (object.name)</field>
  </record>
</odoo>