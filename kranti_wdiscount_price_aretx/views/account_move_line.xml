<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_invoice_discounted_rate" model="ir.ui.view">
        <field name="name">account.move.form.invoice.discounted.rate</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']"
                   position="after">

                <field name="discounted_unit_price"
                       string="Discounted Rate"
                       optional="show"/>

            </xpath>

        </field>
    </record>

</odoo>