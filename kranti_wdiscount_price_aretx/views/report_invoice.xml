<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="hide_discount_column_invoice"
              inherit_id="account.report_invoice_document">

        <!-- Remove Discount Header -->
        <xpath expr="//th[@name='th_discount']"
               position="replace">
        </xpath>

        <!-- Remove Discount Value -->
        <xpath expr="//td[@name='td_discount']"
               position="replace">
        </xpath>

         <!-- Change Unit Price to discounted Unit Price -->
        <xpath expr="//span[@t-field='line.price_unit']"
            position="replace">

            <span
                t-field="line.discounted_unit_price"
                t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>

        </xpath>
    </template>

</odoo>