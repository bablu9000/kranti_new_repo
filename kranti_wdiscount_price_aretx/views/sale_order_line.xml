<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_discounted_price_form_view" model="ir.ui.view">
        <field name="name">sale.order.discounted.price.form.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']//list//field[@name='discount']"
                   position="after">

                <field name="discounted_unit_price"
                       string="Discounted Rate"
                       optional="show"/>

            </xpath>

        </field>
    </record>

</odoo>